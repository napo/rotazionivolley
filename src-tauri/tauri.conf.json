{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rotazioni Volley",
  "version": "2.0.0",
  "identifier": "it.volleyserve.rotazioni",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --workspace web",
    "beforeBuildCommand": "npm run build --workspace web"
  },
  "app": {
    "windows": [
      {
        "title": "Rotazioni Volley",
        "width": 1100,
        "height": 850,
        "minWidth": 480,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
